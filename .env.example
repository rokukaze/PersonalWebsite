# Rails Master Key
# Required for Rails credentials decryption
# Get this from backend/config/master.key or generate a new one
RAILS_MASTER_KEY=your_rails_master_key_here

# Optional: Database Configuration
# These are already set in compose.yml, but you can override them here if needed
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=backend_production

# Optional: Backend Environment Variables
# RAILS_ENV=production
# DATABASE_URL=postgresql://postgres:postgres@db:5432/backend_production

# Optional: Frontend Environment Variables
# NODE_ENV=production
# REACT_APP_API_URL=http://backend:80
